# The lockfile was resolved with legacy peer handling during the Next 15 +
# React 19 upgrade (Next declares a peerOptional on @playwright/test that npm 10
# treats as a hard conflict). Pinning it here keeps `npm install` and `npm ci`
# in agreement across local machines and CI — without it, npm 11 locally
# succeeds while npm 10 on the runner fails, which is exactly how CI silently
# broke.
legacy-peer-deps=true
