# Public site URL — used for canonical URLs, sitemap, RSS, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live ATS ingestion. Default is ON: the site pulls real jobs (real apply
# links) from the company allow-list. Set to "false" to run fully offline on
# the bundled seed data (useful with no network).
ANYWHERE_LIVE=true
# How long live results are cached before a re-poll (ms). Default 30 min.
ANYWHERE_CACHE_TTL_MS=1800000

# Postgres connection (optional). When unset, the app uses the live store in
# src/lib/store.ts (with seed fallback). See README "Storage".
DATABASE_URL=

# Email service provider for the newsletter (optional).
RESEND_API_KEY=

# Secret guarding the /api/ingest cron endpoint.
INGEST_SECRET=change-me

# Google AdSense (optional). Set your publisher id to switch ads on everywhere
# (loader script, google-adsense-account meta, ads.txt, and every <AdSlot>).
# Leave blank to emit no ad code at all.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional default responsive ad-unit id used by <AdSlot> placements.
NEXT_PUBLIC_ADSENSE_SLOT=
