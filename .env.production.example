# Build-time environment for the Cloudflare deploy.
#
# Copy to `.env.production` (gitignored) and fill in before `npm run cf:deploy`.
#
# IMPORTANT: every NEXT_PUBLIC_* value is INLINED INTO THE BUNDLE AT BUILD TIME.
# Putting them in wrangler.jsonc `vars` is NOT enough — they must be present
# here when the build runs, or the features that depend on them silently vanish
# (e.g. an unset NEXT_PUBLIC_SUPABASE_URL removes the subscribe widget entirely).

# Canonical URL — canonical tags, sitemap, RSS, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://getremotejobsnow.com

# Serve from the build-time snapshot. MUST stay false on Workers (no
# long-running process for per-isolate ATS scraping).
ANYWHERE_LIVE=false

# Supabase — presence of the URL is what renders the role-subscribe widget.
# (Public value. The service-role key is a SECRET: `wrangler secret put`.)
NEXT_PUBLIC_SUPABASE_URL=

# Analytics / forms (both have in-code fallbacks; set to override).
NEXT_PUBLIC_GA_ID=G-XXPSMTS8ZX
NEXT_PUBLIC_WEB3FORMS_KEY=1fc4f7b9-f01e-4cea-ba0e-560f07467f89

# AdSense — leave blank to emit no ad code at all.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
NEXT_PUBLIC_ADSENSE_INFEED_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=

# Optional logo.dev token for HQ company logos.
NEXT_PUBLIC_LOGO_TOKEN=
