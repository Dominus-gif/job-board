# Cloudflare static-asset headers.
#
# Files under public/ are served with `max-age=0, must-revalidate` by default,
# so every visit revalidates the brand mark and the hero's dot-matrix mask even
# though neither changes between deploys. These names are stable and the files
# are regenerated by hand (scripts/build-world-map.ts, the logo exports), so a
# month is safe: change the filename when the artwork changes.
/world-dots.svg
  Cache-Control: public, max-age=2592000
/brand-logo-96.webp
  Cache-Control: public, max-age=2592000
/brand-logo-dark-96.webp
  Cache-Control: public, max-age=2592000
/brand-logo-96.png
  Cache-Control: public, max-age=2592000
/brand-logo-dark-96.png
  Cache-Control: public, max-age=2592000
/icon.png
  Cache-Control: public, max-age=2592000
/apple-icon.png
  Cache-Control: public, max-age=2592000
/footer-landscape.jpg
  Cache-Control: public, max-age=2592000
